<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Usability Testing Report</title>

<style>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f4f6fa;
    color: #1f2937;
}

header {
    background: #4f46e5;
    color: white;
    padding: 35px 8%;
}

header h1 {
    margin-bottom: 10px;
}

.container {
    width: 85%;
    margin: 30px auto;
}

.summary {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 20px;
}

.box {
    background: white;
    padding: 25px;
    border-radius: 15px;
    box-shadow: 0 5px 15px rgba(0,0,0,.08);
}

.box h2 {
    color: #4f46e5;
}

.number {
    font-size: 32px;
    font-weight: bold;
    margin-top: 10px;
}

.section {
    margin-top: 35px;
}

table {
    width: 100%;
    background: white;
    border-collapse: collapse;
}

th,td {
    padding: 15px;
    border-bottom: 1px solid #ddd;
    text-align: left;
}

th {
    background: #4f46e5;
    color: white;
}

.high {
    color: #dc2626;
    font-weight: bold;
}

.medium {
    color: #d97706;
    font-weight: bold;
}

.low {
    color: #16a34a;
    font-weight: bold;
}

button {
    padding: 12px 20px;
    margin-top: 20px;
    background: #4f46e5;
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
}

button:hover {
    background: #3730a3;
}

@media(max-width:700px) {

    .summary {
        grid-template-columns: 1fr 1fr;
    }

    .container {
        width: 92%;
    }

    table {
        font-size: 13px;
    }

}

</style>

</head>

<body>

<header>

<h1>Usability Testing Report</h1>

<p>Fintech Mobile Application</p>

</header>


<div class="container">


<div class="summary">

<div class="box">

<h2>Participants</h2>

<div class="number">10</div>

</div>


<div class="box">

<h2>Tasks</h2>

<div class="number">8</div>

</div>


<div class="box">

<h2>Success Rate</h2>

<div class="number">87%</div>

</div>


<div class="box">

<h2>Issues Found</h2>

<div class="number">6</div>

</div>

</div>


<div class="section">

<h2>Testing Results</h2>

<br>

<table>

<tr>

<th>Task</th>
<th>Success</th>
<th>Time</th>
<th>Status</th>

</tr>

<tr>

<td>Login</td>
<td>10/10</td>
<td>20 sec</td>
<td class="low">Good</td>

</tr>

<tr>

<td>Send Money</td>
<td>8/10</td>
<td>55 sec</td>
<td class="medium">Needs Improvement</td>

</tr>

<tr>

<td>Check Balance</td>
<td>10/10</td>
<td>15 sec</td>
<td class="low">Good</td>

</tr>

<tr>

<td>Pay Bill</td>
<td>7/10</td>
<td>80 sec</td>
<td class="high">Problem</td>

</tr>

</table>

</div>


<div class="section">

<h2>Problems Identified</h2>

<br>

<table>

<tr>

<th>Problem</th>
<th>Severity</th>
<th>Recommendation</th>

</tr>

<tr>

<td>Transfer button difficult to find</td>

<td class="high">High</td>

<td>Make the button more visible</td>

</tr>

<tr>

<td>Payment process confusing</td>

<td class="medium">Medium</td>

<td>Simplify payment steps</td>

</tr>

<tr>

<td>Small text on transaction page</td>

<td class="low">Low</td>

<td>Increase font size</td>

</tr>

</table>


<button onclick="showReport()">
View Final Recommendation
</button>

</div>


</div>


<script>

function showReport() {

alert(
"Final Recommendation:\n\n" +
"1. Improve navigation\n" +
"2. Make important buttons more visible\n" +
"3. Simplify payment process\n" +
"4. Increase text readability"
);

}

</script>

</body>

</html>
